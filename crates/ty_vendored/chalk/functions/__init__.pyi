from typing import Any, TypeVar

from ty_chalk_extensions import Resolved

_T = TypeVar("_T")

def if_then_else(
    condition: Resolved[bool | None],
    if_true: _T | Resolved[_T],
    if_false: _T | Resolved[_T],
) -> Resolved[_T]: ...

# Explicit declarations let semantic inference recognize row-dependent calls through aliases.
def max_by(dataframe: Any, sort: Any) -> Any: ...
def min_by(dataframe: Any, sort: Any) -> Any: ...
def max_by_n(dataframe: Any, sort: Any, n: int) -> Any: ...
def min_by_n(dataframe: Any, sort: Any, n: int) -> Any: ...
def __getattr__(name: str) -> Any: ...
